# ─── AQI24 — Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your own credentials.
# Never commit .env to version control.

# Optional backend base URL (for future API hosting)
VITE_API_URL=

# WAQI (World Air Quality Index) API Token — for live station data
# Get a free token at: https://aqicn.org/data-platform/token/
VITE_WAQI_API_TOKEN=

# NASA FIRMS Map Key — for active fire data
# Register at: https://firms.modaps.eosdis.nasa.gov/api/area/
VITE_NASA_FIRMS_MAP_KEY=

# Supabase (optional — for sign-in and persistent storage)
# The app runs without these: the dashboard is public and "Continue as Guest"
# works immediately. Only add credentials to enable real accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini API (optional — for AI assistance features)
VITE_GEMINI_API_KEY=
