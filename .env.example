# ─── Air Quality Intelligence Platform — Environment Variables ───────────────
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.

# Wildfire Prediction API backend base URL
VITE_API_URL=https://backend-aqi24.onrender.com

# WAQI (World Air Quality Index) API Token
# Get a free token at: https://aqicn.org/data-platform/token/
VITE_WAQI_API_TOKEN=d3ee354d215ad96468bf6d03b02c92b14674caa8

# NASA FIRMS Map Key (for active fire data)
# Register at: https://firms.modaps.eosdis.nasa.gov/api/area/
VITE_NASA_FIRMS_MAP_KEY=cf4a717b62a32c5a2c8ba3c91d983751

# Supabase (optional — for persistent storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini API (optional — for AI features)
VITE_GEMINI_API_KEY=
